{{!
    @template auth_oauth2/sessionexpired

    Render a minimal recovery UI when an OAuth2 login attempt cannot
    proceed due to an expired or missing sesskey.

    The template simply guides the user back to the standard login page
    so they can restart the login flow cleanly.

    Example context (json):
    {
        "fallbackmessage": "Your login session has expired.",
        "loginurl": "https://example.com/login/index.php"
    }
}}

<div class="text-center mt-4">
    <p>{{fallbackmessage}}</p>
    <a href="{{{loginurl}}}" class="btn btn-primary">
        {{#str}}oauth2sessionexpired_backtologin, auth_oauth2{{/str}}
    </a>
</div>
